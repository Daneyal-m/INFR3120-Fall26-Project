<%- include('partials/header') %>

<section class="hero">
    <h2>Campus IT support Helpdesk</h2>
    <p>
        Experiencing a technical issue, network outage, hardware failure, or software crash? 
        Log your technical issue in here so our IT support team can resolve it quickly.
    </p>
  <a href="/tickets/new" class="btn-hero">Submit Ticket</a>

</section>

<!--ticket list section-->
<section class="ticket-dashboard">
  <h3>Active Support Tickets</h3>
  <!-- Member 2 (Xaiver Leung)  add the submitted ticket table here -->
  <!--when there is 0 tickets-->
  <% if (tickets.length === 0) { %>
    <p>No support tickets submitted yet.</p>
  <% } else { %>
    <!--create a table when there are tickets-->
    <table class="table table-bordered table-striped table-hover">
      <!--table headers-->
      <thead>
        <tr> 
          <th class="text-center">Date</th> 
          <th class="text-center">Title</th> 
          <th class="text-center">Category</th> 
          <th class="text-center">Location</th> 
          <th class="text-center">Priority</th> 
        </tr>
      </thead>

      <!--table body-->
      <tbody>
        <!--loops through every ticket in the list-->
        <% for (let count=0; count<tickets.length; count++) {%>
          <tr>
            <!--prints the ticket info-->
            <td class="text-center"><%= tickets[count].dateSubmitted %></td> 
            <td class="text-center"><%= tickets[count].title %></td> 
            <td class="text-center"><%= tickets[count].category %></td> 
            <td class="text-center"><%= tickets[count].location %></td> 
            <td class="text-center"><%= tickets[count].priority %></td> 
          </tr>
        <% } %>
      </tbody>
    </table>
  <% } %>
</section>

<%- include('partials/footer') %>